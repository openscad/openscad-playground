+ function deep_fallthrough() {
+  var acc = 0, wasm2js_i32$0 = 0;
+  ft0 : {
+   ft1 : {
+    ft2 : {
+     ft3 : {
+      ft4 : {
+       ft5 : {
+        ft6 : {
