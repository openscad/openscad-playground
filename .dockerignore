# Keep the build context small and reproducible. All of these are either
# regenerated by `npm run build:all` or irrelevant to the image.

# VCS / CI metadata
.git
.gitignore
.github

# Installed + generated build artifacts (rebuilt inside the image)
node_modules
dist
libs
public/libraries
public/openscad.js
public/openscad.wasm
src/wasm

# Docs and editor cruft
*.md
!LICENSE.md
.DS_Store
npm-debug.log*
